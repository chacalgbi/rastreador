<% content_for :head do %>
  <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
<% end %>

<div class="auth-screen">
  <%= render "shared/auth_brand" %>

  <section class="auth-panel">
    <div class="auth-card">
      <h2 class="auth-card__title">Esqueceu sua senha?</h2>
      <p class="auth-card__subtitle">Enviaremos instruções de recuperação para seu telefone ou e-mail</p>

      <%= tag.div(flash[:alert], style: "color:#f87171; margin-block-start:1rem; font-size:.9rem;") if flash[:alert] %>

      <%= form_with url: passwords_path do |form| %>
        <div class="auth-field">
          <%= form.label :phone, "Telefone ou e-mail" %>
          <div class="auth-field__control">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <%= form.text_field :phone, required: true, autofocus: true, autocomplete: "username", placeholder: "Insira o telefone ou e-mail que usou no cadastro", value: params[:phone], class: 'input' %>
          </div>
        </div>

        <%= form.submit "Enviar instruções de recuperação", class: 'btn auth-btn' %>

        <div class="auth-links">
          <%= link_to 'Voltar ao login', new_session_path %>
        </div>
      <% end %>
    </div>

    <p class="auth-foot">GPS · Telemetria · Bloqueio remoto · Monitoramento 24h</p>
  </section>
</div>